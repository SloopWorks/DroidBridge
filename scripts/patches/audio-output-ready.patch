 enum scrcpy_exit_code
 scrcpy(struct scrcpy_options *options) {
+    // DroidBridge's independent supervisor owns the exact forward identity.
+    const char *owned_scid = getenv("DROIDBRIDGE_AUDIO_SCID");
+    uint32_t audio_scid = 0;
+    if (owned_scid) {
+        if (options->video || !options->audio || options->control
+                || !options->force_adb_forward || strlen(owned_scid) != 8
+                || owned_scid[0] < '0' || owned_scid[0] > '7') {
+            LOGE("Invalid supervised audio session configuration");
+            return SCRCPY_EXIT_FAILURE;
+        }
+        for (unsigned i = 0; i < 8; ++i) {
+            const char *digit = strchr("0123456789abcdef", owned_scid[i]);
+            if (!digit) {
+                LOGE("Invalid supervised audio session identity");
+                return SCRCPY_EXIT_FAILURE;
+            }
+            audio_scid = (audio_scid << 4) | (uint32_t) (owned_scid[i] <= '9' ? owned_scid[i] - '0' : owned_scid[i] - 'a' + 10);
+        }
+    }
     static struct scrcpy scrcpy;
 #ifndef NDEBUG
     // Detect missing initializations
